#!/bin/bash

# <SETUP>

# check if pwd is ~/.dotfiles
if [ ! "$PWD" = "$HOME/.dotfiles" ]; then
    echo "Please run this script from the ~/.dotfiles directory."
    exit 1
fi

# acquire dependencies
git submodule update --init --recursive

# configure pacman
sudo cp -f root/etc/pacman.conf /etc/
sudo pacman -Syuu --noconfirm

# configure makepkg
sudo cp -f root/etc/makepkg.conf /etc/

# installing yay manually before using yay
git clone https://aur.archlinux.org/yay-bin.git
(
  cd yay-bin || exit
  makepkg --syncdeps --rmdeps --noconfirm
  sudo pacman -U --noconfirm -- *.pkg.tar.zst
)
rm -rf yay-bin

# </SETUP>



# <ROOT>

yay -S --noconfirm --answerdiff=None --sudoloop                             \
    acpi adw-gtk-theme alsa-utils bluez bolt brightnessctl cpupower cronie  \
    dnsmasq exfatprogs fuse2 jre-openjdk linux-zen-headers networkmanager   \
    nvidia-open-dkms otf-ipafont pacman-contrib playerctl qemu-desktop      \
    reflector samba sof-firmware woff2-font-awesome ttf-ia-writer           \
    ttf-jetbrains-mono-nerd ttf-ms-win10-cdn udiskie udisks2

# install config files
sudo rm /boot/loader/entries/* # remove default entries
sudo cp -rvf --no-preserve=mode,ownership root/boot/loader/* /boot/loader/
sudo cp -rvf --no-preserve=mode,ownership root/etc/* /etc/

# load new systemd units, now that config files are installed
sudo systemctl daemon-reload

# enable units for the next boot
sudo systemctl enable                                       \
    bluetooth.service cpupower.service cronie.service       \
    intel-rapl-performance.service NetworkManager.service   \
    paccache.timer reflector.service swapfile.swap

# build swapfile
if [ -z "$CI" ]; then
    # NOTE: multiple is `zswap.max_pool_percent` x 2.5 (assumed compression)
    swap_kib=$(awk '
        /^MemTotal:/ {
            mem = $2 * 1.5; cap = 32 * 1024 * 1024
            printf "%.0f\n", (mem < cap ? mem : cap)
        }
    ' /proc/meminfo)
    swap_name=swapfile
else
    # in CI, `/swapfile` may already exist, and a real one wastes space
    # NOTE: once it starts to matter, add an override to `swapfile.swap.d`
    swap_kib=1048576  # 1 GiB
    swap_name=swapfile2  # avoid conflict with `/swapfile`
fi
sudo systemctl stop swapfile.swap || true  # stop using swap if it is being used
sudo mkswap -U clear --size "$swap_kib"KiB --file /"$swap_name"

# </ROOT>



# <USER>

# install packages
yay -S --noconfirm --answerdiff=None --sudoloop                             \
    act audacity antigravity-cli arduino-cli bats bats-assert bats-file     \
    bats-support bc bluetui bun discord firefox fish freecad fd flatpak     \
    ggml-cuda github-cli ghostscript gimp git-lfs gparted imagemagick       \
    inkscape jq kicad kicad-library kicad-library-3d libreoffice-fresh      \
    llama-cpp lsfg-vk ltspice lutris macchina man-db neovim parallel        \
    perl-image-exiftool picom-git podman polkit-gnome pre-commit            \
    prismlauncher prusa-slicer pyenv python-huggingface-hub python-pydantic \
    python-pydantic-settings rpi-imager ripgrep rclone rsync rofi ruby      \
    rumdl shellcheck steam thunderbird trash-cli tree tree-sitter-cli unzip \
    virt-manager vlc xclip yaycache yazi zip zopfli

# install awesome-luajit-git with docs explicitly disabled (breaks with Lua 5.5)
_BUILD_DOCS=0 yay -S --noconfirm --answerdiff=None awesome-luajit-git

flatpak install --noninteractive flathub    \
    com.google.Chrome org.zotero.Zotero io.github.streetpea.Chiaki4deck \
    io.github.shundhammer.qdirstat net.rpcs3.RPCS3 com.logseq.Logseq    \
    org.freedesktop.Platform.VulkanLayer.lsfgvk//24.08                  \
    org.freedesktop.Platform.VulkanLayer.lsfgvk//25.08                  \
    org.freedesktop.Platform.VulkanLayer.lsfgvk//26.08

# give Vulkan applications access to lsfg-vk config
for app in "io.github.streetpea.Chiaki4deck" "net.rpcs3.RPCS3"; do
    flatpak override --user --filesystem "$HOME"/.config/lsfg-vk:ro "$app"
    flatpak override --user \
        --filesystem "$HOME"/.local/share/Steam/steamapps/common:ro "$app"
    flatpak override --user \
        --env LSFG_CONFIG="$HOME"/.config/lsfg-vk/conf.toml "$app"
done

# given Logseq access to pre-commit
sudo flatpak override --filesystem host-os:ro com.logseq.Logseq
sudo flatpak override --env PYTHONPATH=/run/host/lib/python3.14/site-packages

# install jekyll through ruby
gem install jekyll bundler

# install pi (and extensions)
export BUN_INSTALL_CACHE_DIR="$HOME"/.cache/bun
export BUN_INSTALL_BIN="$HOME"/.local/bin
export BUN_INSTALL="${XDG_DATA_HOME:-"$HOME"/.local/share}"/bun
export PATH="$PATH:$BUN_INSTALL_BIN"
bun add -g --ignore-scripts @earendil-works/pi-coding-agent
pi install git:github.com/earendil-works/pi-review

# install config files
mkdir -p ~/.config
ln -s -f "$PWD"/config/* ~/.config/

# install git.yazi plugin (if not already installed)
if [ ! -d "$PWD"/config/yazi/plugins/git.yazi ]; then
    ya pkg add yazi-rs/plugins:git
fi

# symlink home files by hand (NOTE: ~/ is far less flat than ~/.config)
ln -sf "$PWD"/home/.bashrc ~/
ln -sf "$PWD"/home/.xinitrc ~/
ln -sf "$PWD"/home/.Xresources ~/
mkdir -p ~/.local/bin && ln -sf "$PWD"/home/.local/bin/* ~/.local/bin/
mkdir -p ~/.local/share/applications && \
    ln -sf "$PWD"/home/.local/share/applications/* ~/.local/share/applications/
mkdir -p ~/.pi/agent && ln -sf "$PWD"/home/.pi/agent/* ~/.pi/agent/

# copy in home files by hand
mkdir -p ~/.var/app && cp -r -f "$PWD"/home/.var/app/* ~/.var/app/

# libvirt is actually a root service!
sudo cp -f root/etc/libvirt/libvirtd.conf /etc/libvirt/ 

# deal with rclone config edge case
unlink ~/.config/rclone # undo symlink b/c it eventually contains keys we don't want to commit...
mkdir ~/.config/rclone  #  ...so we'll only copy the config files
cp "$PWD"/config/rclone/rclone.conf ~/.config/rclone/
# rclone is not authorized yet, so authorize manually in recovery

# other config
sudo usermod -a -G uucp,libvirt "$(id -un)"  # needed for arduino and virt-manager
sudo systemctl enable libvirtd.service
xdg-mime default yazi.desktop inode/directory # by default, vscode seems to be the default file manager
crontab crontab.bak

systemctl --user enable ssh-agent.socket
systemctl --user enable podman.socket

# </USER>



# <CLEANUP>

yay -Sc --noconfirm

# </CLEANUP>
