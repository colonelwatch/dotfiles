[user]
	name = Kenny Peng
	email = 53552802+colonelwatch@users.noreply.github.com
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[trailer "pi-trailer"]
	ifexists = doNothing
	key = Co-Authored-By
	cmd = "echo \"$PI_MODEL\" \"<noreply@pi.dev>\""
[hook "pi-trailer"]
	command = "bash -c 'if [ -n \"$PI_MODEL\" ]; then git interpret-trailers --trailer pi-trailer --in-place -- \"$0\" \"$@\"; fi'"
	event = commit-msg
