[user]
	name = Kenny Peng
	email = 53552802+colonelwatch@users.noreply.github.com
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[hook "pi-trailer"]
	command = "sh -c 'if [ -n \"$PI_MODEL\" ] && [ \"$1\" != merge ] && [ \"$1\" != squash ]; then git interpret-trailers --if-exists addIfDifferent --trailer \"Co-Authored-By: $PI_MODEL <noreply@pi.dev>\" --in-place -- \"$0\"; fi'"
	event = prepare-commit-msg
